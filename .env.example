# Copy to .env.local. Both values are read on the server only; nothing
# here ever reaches the browser.

# Which product this deploy is.
#   true  = demo: serves the recorded example runs in lib/examples/ and
#           never calls the model, even if a key is set below.
#   false = live: your own library and the full Muse Spark pipeline.
# Anything other than "false" (including leaving it out) means demo, so a
# deploy with a missing variable fails closed.
USE_MOCK=true

# Meta Model API key, needed only in live mode (USE_MOCK=false).
MODEL_API_KEY=
